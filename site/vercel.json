{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/lowell",
      "destination": "/ma/?town=Lowell",
      "permanent": false
    },
    {
      "source": "/lowell/:path((?!sw.js$).*)",
      "destination": "/ma/?town=Lowell",
      "permanent": false
    },
    {
      "source": "/nashua",
      "destination": "/nh/?town=Nashua",
      "permanent": false
    },
    {
      "source": "/nashua/:path((?!sw.js$).*)",
      "destination": "/nh/?town=Nashua",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
