{
  "name": "SafeWalk Lowell",
  "short_name": "SafeWalk",
  "description": "Halloween walking map of Level 2 and Level 3 registered addresses in Lowell, MA and the six towns around it.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e1014",
